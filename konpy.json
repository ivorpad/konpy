{
  "$schema": "./konpy.schema.json",
  "version": "v1",
  "conventions": [
    {
      "name": "packages-have-init",
      "description": "Every konpy subpackage is a regular package.",
      "paths": [
        "src/konpy/cli",
        "src/konpy/config",
        "src/konpy/core",
        "src/konpy/predicates",
        "src/konpy/python_ast"
      ],
      "must": {
        "haveType": "directory",
        "haveFiles": ["__init__.py"]
      }
    },
    {
      "name": "predicate-modules-export-check",
      "description": "Each predicate module exposes its check_<module> function.",
      "paths": "src/konpy/predicates/{module}.py",
      "excludeFiles": [
        "src/konpy/predicates/__init__.py",
        "src/konpy/predicates/registry.py",
        "src/konpy/predicates/_duplication_index.py",
        "src/konpy/predicates/_handlers.py",
        "src/konpy/predicates/_plugin.py",
        "src/konpy/predicates/_restrict_annotations_matching.py",
        "src/konpy/predicates/_utils.py",
        "src/konpy/predicates/_wildcards.py",
        "src/konpy/predicates/declaration_utils.py",
        "src/konpy/predicates/import_.py"
      ],
      "must": {
        "export": ["check_${module}"]
      }
    }
  ],
  "verify": {
    "steps": [
      {
        "name": "schema-freshness",
        "run": ["python", "scripts/generate_schema.py", "--check"]
      },
      {
        "name": "guidance-freshness",
        "run": ["python", "scripts/verify", "guidance", "--check"]
      },
      { "name": "ruff", "run": ["ruff", "check"] },
      { "name": "basedpyright", "run": ["basedpyright"] },
      { "name": "import-linter", "run": ["lint-imports"] },
      {
        "name": "konpy-validate",
        "run": ["python", "-m", "konpy", "validate", "--config-path", "konpy.json"]
      },
      {
        "name": "konpy-validate-strict",
        "run": ["python", "-m", "konpy", "validate", "--config-path", "konpy.strict.json"]
      },
      {
        "name": "konpy-strict",
        "run": ["python", "-m", "konpy", "check", "--config-path", "konpy.strict.json"]
      },
      { "name": "pytest", "run": ["python", "-m", "pytest", "-q"] }
    ]
  }
}
