{
  "version": "v1",
  "extends": ["./konpy.json"],
  "conventionSources": {
    "bp": "./packs/python-best-practices.json"
  },
  "conventions": [
    {
      "use": "bp/init-files-are-barrels",
      "paths": "src/konpy/**/__init__.py"
    },
    {
      "use": "bp/absolute-imports-only",
      "paths": ["src/konpy/**/*.py", "!src/konpy/**/__init__.py"]
    },
    {
      "use": "bp/no-underscore-exports",
      "paths": "src/konpy/**/*.py"
    },
    {
      "use": "bp/docstrings-on-public-api",
      "paths": ["src/konpy/**/*.py", "!src/konpy/**/__init__.py"]
    },
    {
      "use": "bp/annotated-public-functions",
      "paths": ["src/konpy/**/*.py", "!src/konpy/**/__init__.py"]
    },
    {
      "name": "max-module-length",
      "description": "Modules longer than 300 lines should be split.",
      "paths": "src/konpy/**/*.py",
      "must": { "restrictFileLength": { "maxLines": 300 } }
    },
    {
      "name": "tests-never-skip",
      "description": "Tests are deleted or fixed, never skipped; environment-conditional runs use skipif.",
      "hint": "Remove the skip/xfail marker and fix or delete the test, or use pytest.mark.skipif for a real environment condition.",
      "paths": ["tests/**/*.py", "!tests/e2e/fixtures/**"],
      "must": { "restrictDecorators": { "forbid": ["pytest.mark.skip", "pytest.mark.xfail"] } }
    }
  ],
  "unusedCode": {
    "include": ["src/konpy/**/*.py"]
  }
}
